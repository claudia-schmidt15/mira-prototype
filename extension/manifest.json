{
  "manifest_version": 3,
  "name": "Mira",
  "description": "Safety-aware routing and whispers for Google Maps",
  "version": "0.1",

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_scripts": [
    {
      "matches": ["https://www.google.com/maps/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "permissions": [],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ]
}


